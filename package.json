{
  "name": "orbit-orchard",
  "version": "0.1.2",
  "private": true,
  "description": "A tiny packaged arcade game for Release QA candidate integration",
  "author": "Frogbyte",
  "main": "app/main.cjs",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "package:windows": "electron-builder --win nsis --x64 --publish never",
    "package:linux": "electron-builder --linux deb --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.frogbyte.orbit-orchard",
    "productName": "Orbit Orchard",
    "asar": true,
    "files": [
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "Orbit-Orchard-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    },
    "linux": {
      "target": "deb",
      "category": "Game",
      "maintainer": "Release QA Sandbox <noreply@example.com>"
    }
  }
}
